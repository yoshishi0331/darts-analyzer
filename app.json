{
  "expo": {
    "name": "Darts Analyzer",
    "slug": "darts-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "リリース点入力に使う動画を選ぶために写真ライブラリへのアクセスを使用します。"
        }
      ],
      "expo-video"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "音声入力でダーツの結果を記録するためにマイクを使用します。",
        "NSSpeechRecognitionUsageDescription": "音声認識でダーツの結果をテキストに変換するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.dartsanalyzer"
    }
  }
}
