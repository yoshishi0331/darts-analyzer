{
  "expo": {
    "name": "Darts Analyzer",
    "slug": "darts-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "リリース点入力に使う動画を選ぶために写真ライブラリへのアクセスを使用します。"
        }
      ],
      "expo-video"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.dartsanalyzer"
    }
  }
}
